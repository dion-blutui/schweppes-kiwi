{% canopy config %}
{
    "title": "Hero",
    "name": "hero",
    "settings": [
        { "name": "heading", "type": "heading", "label": "Headline", "tab": "Content",
          "elements": [{ "value": "h1", "label": "Heading 1" }, { "value": "h2", "label": "Heading 2" }],
          "default": { "value": "New Schweppes Antipodean Kiwi & Lime", "element": "h1" } },
        { "name": "subheading", "type": "text", "label": "Sub headline", "tab": "Content",
          "default": "For a burst of Kiwi excitement in your otherwise Meh day." },
        { "name": "image", "type": "file", "label": "Hero image", "accept": "image/*", "tab": "Content",
          "description": "Full width photograph behind the headline." },
        { "name": "backdrop", "type": "file", "label": "Backdrop image", "accept": "image/*", "tab": "Content",
          "description": "Soft out of focus image tinted behind the hero." },
        { "name": "show_scroll_cue", "type": "checkbox", "label": "Show scroll cue", "tab": "Style", "default": true }
    ]
}
{% endcanopy %}

{% canopy template %}
{% set hero_image = settings.image.path|default(asset('images/hero-kiwi-lime.png')) %}
{% set hero_backdrop = settings.backdrop.path|default(asset('images/hero-backdrop.png')) %}

<section class="relative isolate overflow-hidden bg-olive pt-60">
  <img
    src="{{ hero_backdrop | image_url({ width: 1600, format: 'webp' }) }}"
    alt=""
    aria-hidden="true"
    class="absolute inset-0 h-full w-full object-cover opacity-20"
  />

  <img
    src="{{ hero_image | image_url({ width: 1600, format: 'webp' }) }}"
    alt=""
    aria-hidden="true"
    class="absolute inset-x-0 top-0 h-full w-full object-cover lg:h-[77%]"
  />

  <div
    class="absolute inset-x-0 bottom-0 h-3/5 bg-gradient-to-t from-black/70 to-transparent lg:hidden"
    aria-hidden="true"
  ></div>

  <div
    class="absolute inset-x-0 top-[35%] hidden h-[42%] bg-gradient-to-b from-white to-[#737373] mix-blend-multiply lg:block"
    aria-hidden="true"
  ></div>

  <div class="shell relative flex min-h-[520px] flex-col justify-end pb-14 pt-24 lg:min-h-[742px] lg:pb-[88px]">
    <div class="max-w-[845px]">
      <{{ settings.heading.element }}
        class="font-display text-[40px] font-bold uppercase leading-[0.9] tracking-[0.5px] text-off-white sm:text-[52px] lg:text-[68px]"
      >
        {{ settings.heading.value }}
      </{{ settings.heading.element }}>

      {% if settings.subheading %}
        <p class="mt-[19px] text-[16px] font-semibold leading-tight tracking-[0.5px] text-white lg:text-[20px]">
          {{ settings.subheading }}
        </p>
      {% endif %}
    </div>
  </div>


  {% if settings.show_scroll_cue %}
    <div class="absolute inset-x-0 bottom-5 flex justify-center" aria-hidden="true">
      <svg class="scroll-cue h-[16px] w-[33px]" viewBox="0 0 32.909 16.5" fill="none">
        <path d="M16.4545 16.5L0 0h32.909L16.4545 16.5Z" fill="#5BA63D" />
      </svg>
    </div>
  {% endif %}
</section>
{% endcanopy %}
