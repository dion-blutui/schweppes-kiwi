{% canopy config %}
{
    "title": "Hero",
    "name": "hero",
    "settings": [
        { "name": "image", "type": "file", "label": "Hero image", "accept": "image/*", "tab": "Content",
          "description": "The whole hero as one piece of artwork — headline, sub headline and photography are all part of the image." },
        { "name": "alt", "type": "text", "label": "Image description", "tab": "Content",
          "help": "Read out by screen readers and shown if the image fails to load. Repeat whatever wording appears in the artwork.",
          "default": "New Schweppes Antipodean Kiwi & Lime — for a burst of Kiwi excitement in your otherwise Meh day." },
        { "name": "show_scroll_cue", "type": "checkbox", "label": "Show scroll cue", "tab": "Style", "default": true }
    ]
}
{% endcanopy %}

{% canopy template %}
{#
  The artwork carries the headline, so it is never cropped or overlaid — the section is
  simply as tall as the image. Anything that has to sit on top of it, like the scroll
  cue, is UI rather than content.
#}
{% set hero_image = settings.image.path|default(asset('images/hero-kiwi-lime.png')) %}

<section class="relative bg-olive">
  <img
    src="{{ hero_image | image_url({ width: 1920, format: 'webp' }) }}"
    alt="{{ settings.alt }}"
    class="block w-full"
  />

  {% if settings.show_scroll_cue %}
    <div class="absolute inset-x-0 bottom-5 flex justify-center" aria-hidden="true">
      <svg class="scroll-cue h-[16px] w-[33px]" viewBox="0 0 32.909 16.5" fill="none">
        <path d="M16.4545 16.5L0 0h32.909L16.4545 16.5Z" fill="#5BA63D" />
      </svg>
    </div>
  {% endif %}
</section>
{% endcanopy %}
