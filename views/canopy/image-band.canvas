{% canopy config %}
{
    "title": "Full width image",
    "name": "image_band",
    "settings": [
        { "name": "image", "type": "file", "label": "Image", "accept": "image/*" },
        { "name": "alt", "type": "text", "label": "Alt text",
          "description": "Leave empty if the image is purely decorative.",
          "default": "" },
        { "name": "height", "type": "select", "label": "Band height",
          "options": [
            { "value": "short", "label": "Short" },
            { "value": "medium", "label": "Medium" },
            { "value": "tall", "label": "Tall" }
          ],
          "default": "tall" }
    ]
}
{% endcanopy %}

{% canopy template %}
{% set band = settings.image.path|default(asset('images/kiwi-lime-lifestyle.png')) %}
{% set heights = { short: 'h-[240px] lg:h-[380px]', medium: 'h-[300px] lg:h-[540px]', tall: 'h-[340px] lg:h-[702px]' } %}

<section class="bg-white">
  <img
    src="{{ band | image_url({ width: 1600, format: 'webp' }) }}"
    alt="{{ settings.alt }}"
    {% if settings.alt is empty %}aria-hidden="true"{% endif %}
    class="w-full object-cover {{ heights[settings.height]|default(heights.tall) }}"
  />
</section>
{% endcanopy %}
